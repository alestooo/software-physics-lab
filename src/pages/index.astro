---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";

const topics = [
  {
    number: "01",
    title: "Movimiento",
    description: "Trayectorias, posición, velocidad y aceleración.",
    href: "/dron",
    icon: "orbit",
  },
  {
    number: "02",
    title: "Gravedad",
    description: "Caída libre, saltos y simulación numérica.",
    href: "/salto-videojuegos",
    icon: "planet",
  },
  {
    number: "03",
    title: "Rotación",
    description: "Movimiento circular y gravedad artificial.",
    href: "/gravedad-artificial",
    icon: "rotation",
  },
  {
    number: "04",
    title: "Fricción",
    description: "Contacto, temperatura y agarre de neumáticos.",
    href: "/formula-1",
    icon: "wave",
  },
  {
    number: "05",
    title: "Elasticidad",
    description: "Resortes, fuerza restauradora y sistemas hápticos.",
    href: "/control-haptico",
    icon: "spring",
  },
  {
    number: "06",
    title: "Energía",
    description: "Trabajo, energía cinética y frenado regenerativo.",
    href: "/frenado-regenerativo",
    icon: "energy",
  },
  {
    number: "07",
    title: "Colisiones",
    description: "Momento lineal, restitución y rebotes físicos.",
    href: "/coeficiente-restitucion",
    icon: "collision",
  },
  {
    number: "08",
    title: "Momento angular",
    description: "Torque, rotación y control de actitud satelital.",
    href: "/ruedas-reaccion",
    icon: "angular",
  },
  {
    number: "09",
    title: "Gravitación",
    description: "Trayectorias espaciales y asistencia gravitatoria.",
    href: "/asistencia-gravitatoria",
    icon: "gravity",
  },
];

const methodSteps = [
  {
    number: "01",
    title: "Caso real",
    description:
      "Se parte de un producto, sistema o industria donde el fenómeno físico tenga una aplicación verificable.",
  },
  {
    number: "02",
    title: "Modelo físico",
    description:
      "Se identifican las variables y ecuaciones que permiten describir cuantitativamente el comportamiento.",
  },
  {
    number: "03",
    title: "Aplicación en software",
    description:
      "Se explica por qué calcular el fenómeno físico resulta mejor que utilizar valores fijos o respuestas precalculadas.",
  },
  {
    number: "04",
    title: "Recurso de apoyo",
    description:
      "Cada caso incorpora una simulación, visualización, diagrama o análisis multimedia según lo solicitado.",
  },
];
---

<BaseLayout
  title="Physics × Software"
  description="Portafolio interactivo de Física I sobre aplicaciones reales de la física en Ingeniería del Software."
  fullBleed={true}
>
  <div class="home-page">
    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero-full" id="inicio">
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-gradient hero-gradient-1"></div>
        <div class="hero-gradient hero-gradient-2"></div>
        <div class="hero-gradient hero-gradient-3"></div>

        <div class="hero-stars hero-stars-a"></div>
        <div class="hero-stars hero-stars-b"></div>

        <div class="hero-cut hero-cut-left"></div>
        <div class="hero-cut hero-cut-right"></div>
      </div>

      <!-- TOP BAR -->

      <header class="hero-topbar">
        <a href="/" class="hero-brand" aria-label="Ir al inicio">
          <span class="brand-mark" aria-hidden="true">
            <span class="brand-ring"></span>
            <span class="brand-dot"></span>
          </span>

          <span class="brand-text">
            <span class="brand-word">Physics</span>
            <span class="brand-x">×</span>
            <span class="brand-word">Software</span>
          </span>
        </a>

        <nav class="hero-nav" aria-label="Navegación de portada">
          <a href="#inicio" class="is-active">Inicio</a>
          <a href="#temas">Temas</a>
          <a href="#avances">Avances</a>
          <a href="#metodo">Método</a>

          <a
            href="https://github.com/alestooo/software-physics-lab"
            target="_blank"
            rel="noreferrer"
            class="nav-github"
          >
            <svg
              class="nav-github-icon"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 2.7C6.86 2.7 2.7 6.86 2.7 12C2.7 16.11 5.37 19.6 9.07 20.83C9.53 20.91 9.7 20.63 9.7 20.39V18.76C7.14 19.32 6.6 17.67 6.6 17.67C6.18 16.61 5.57 16.33 5.57 16.33C4.73 15.75 5.63 15.76 5.63 15.76C6.56 15.83 7.05 16.72 7.05 16.72C7.88 18.14 9.23 17.73 9.76 17.49C9.84 16.89 10.08 16.48 10.35 16.25C8.31 16.02 6.16 15.23 6.16 11.7C6.16 10.69 6.52 9.87 7.11 9.23C7.01 9 6.7 8.06 7.2 6.79C7.2 6.79 7.98 6.54 9.73 7.73C10.47 7.52 11.25 7.42 12.03 7.42C12.81 7.42 13.59 7.52 14.33 7.73C16.08 6.54 16.86 6.79 16.86 6.79C17.36 8.06 17.05 9 16.95 9.23C17.54 9.87 17.9 10.69 17.9 11.7C17.9 15.24 15.74 16.01 13.69 16.24C14.02 16.52 14.32 17.07 14.32 17.91V20.39C14.32 20.63 14.49 20.92 14.95 20.83C18.64 19.59 21.3 16.11 21.3 12C21.3 6.86 17.14 2.7 12 2.7Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
            </svg>

            GitHub
          </a>
        </nav>
      </header>

      <!-- HERO MAIN -->

      <div class="hero-main">
        <div class="hero-copy">
          <div class="hero-pill">
            <span>Física</span>
            <i></i>
            <span>Simulación</span>
            <i></i>
            <span>Software</span>
          </div>

          <h1 class="hero-title">
            <span class="hero-title-serif">
              Donde la
              <br />
              física
            </span>

            <span class="hero-title-sans">
              se convierte
              <br />
              en software.
            </span>
          </h1>

          <p class="hero-description">
            Un laboratorio visual acumulativo con nueve casos:
            cinco aplicaciones desarrolladas en el primer avance y
            cuatro nuevos casos sobre conservación y gravitación
            incorporados en este segundo avance.
          </p>

          <div class="hero-actions">
            <a href="#temas" class="button-main">
              Explorar temas
              <span class="button-arrow">→</span>
            </a>

            <a
              href="https://github.com/alestooo/software-physics-lab"
              target="_blank"
              rel="noreferrer"
              class="button-ghost repository-button"
            >
              <span>Ver repositorio</span>

              <svg
                class="repository-github-icon"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M12 2.7C6.86 2.7 2.7 6.86 2.7 12C2.7 16.11 5.37 19.6 9.07 20.83C9.53 20.91 9.7 20.63 9.7 20.39V18.76C7.14 19.32 6.6 17.67 6.6 17.67C6.18 16.61 5.57 16.33 5.57 16.33C4.73 15.75 5.63 15.76 5.63 15.76C6.56 15.83 7.05 16.72 7.05 16.72C7.88 18.14 9.23 17.73 9.76 17.49C9.84 16.89 10.08 16.48 10.35 16.25C8.31 16.02 6.16 15.23 6.16 11.7C6.16 10.69 6.52 9.87 7.11 9.23C7.01 9 6.7 8.06 7.2 6.79C7.2 6.79 7.98 6.54 9.73 7.73C10.47 7.52 11.25 7.42 12.03 7.42C12.81 7.42 13.59 7.52 14.33 7.73C16.08 6.54 16.86 6.79 16.86 6.79C17.36 8.06 17.05 9 16.95 9.23C17.54 9.87 17.9 10.69 17.9 11.7C17.9 15.24 15.74 16.01 13.69 16.24C14.02 16.52 14.32 17.07 14.32 17.91V20.39C14.32 20.63 14.49 20.92 14.95 20.83C18.64 19.59 21.3 16.11 21.3 12C21.3 6.86 17.14 2.7 12 2.7Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>

          <div class="hero-tags">
            <span>
              <i class="tag-dot pink"></i>
              Astro
            </span>

            <span>
              <i class="tag-dot blue"></i>
              TypeScript
            </span>

            <span>
              <i class="tag-dot purple"></i>
              Física I
            </span>

            <span>
              <i class="tag-dot orange"></i>
              9 temas
            </span>
          </div>
        </div>

        <!-- HERO VISUAL -->

        <div class="hero-visual" aria-hidden="true">
          <div class="orbit orbit-1">
            <span class="orbit-node orbit-node-1"></span>
          </div>

          <div class="orbit orbit-2">
            <span class="orbit-node orbit-node-2"></span>
          </div>

          <div class="orbit orbit-3">
            <span class="orbit-node orbit-node-3"></span>
          </div>

          <div class="floating-card model-card">
            <span class="card-corner-dot"></span>

            <div class="card-icon-shell">
              <svg
                class="card-svg-icon"
                viewBox="0 0 24 24"
                fill="none"
              >
                <path
                  d="M12 3L19 7V17L12 21L5 17V7L12 3Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                />

                <path
                  d="M5 7L12 11L19 7M12 11V21"
                  stroke="currentColor"
                  stroke-width="1.7"
                />
              </svg>
            </div>

            <div class="card-copy">
              <small>MODELO</small>
              <strong>Física + simulación</strong>
            </div>
          </div>

          <div class="floating-card equation-card">
            <span class="card-corner-dot"></span>

            <div class="card-icon-shell waveform-shell">
              <svg
                class="card-svg-icon waveform-icon"
                viewBox="0 0 24 24"
                fill="none"
              >
                <path
                  d="M3 12H6L8 6L11 18L14 7L16 14L18 10L21 12"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <div class="card-copy">
              <small>ECUACIÓN</small>
              <strong>modelo → cálculo → resultado</strong>
            </div>

            <span class="equation-accent-line"></span>
          </div>

          <div class="planet planet-a"></div>
          <div class="planet planet-b"></div>
          <div class="planet planet-c"></div>

          <span class="spark spark-1"></span>
          <span class="spark spark-2"></span>
          <span class="spark spark-3"></span>
          <span class="spark spark-4"></span>

          <div class="rocket-wrap">
            <div class="rocket-trails">
              <span class="trail trail-1"></span>
              <span class="trail trail-2"></span>
              <span class="trail trail-3"></span>
            </div>

            <svg
              class="rocket-svg"
              viewBox="0 0 300 430"
              aria-hidden="true"
            >
              <defs>
                <linearGradient
                  id="rocketBodyGradient"
                  x1="0"
                  x2="1"
                  y1="0"
                  y2="1"
                >
                  <stop offset="0%" stop-color="#fff5ff" />
                  <stop offset="52%" stop-color="#e5a9ff" />
                  <stop offset="100%" stop-color="#a253e3" />
                </linearGradient>

                <radialGradient id="rocketWindowGradient">
                  <stop offset="0%" stop-color="#75ebff" />
                  <stop offset="45%" stop-color="#418ee9" />
                  <stop offset="100%" stop-color="#30228f" />
                </radialGradient>
              </defs>

              <path
                d="M150 26C205 74 231 145 221 226L203 319L150 354L97 319L79 226C69 145 95 74 150 26Z"
                fill="url(#rocketBodyGradient)"
                stroke="#fbeaff"
                stroke-width="7"
              />

              <circle
                cx="150"
                cy="140"
                r="45"
                fill="#fff"
                opacity="0.94"
              />

              <circle
                cx="150"
                cy="140"
                r="33"
                fill="url(#rocketWindowGradient)"
              />

              <path
                d="M94 242L42 284L88 325L111 304Z"
                fill="#5527bd"
              />

              <path
                d="M206 242L258 284L212 325L189 304Z"
                fill="#5527bd"
              />

              <path
                class="rocket-fire"
                d="M116 330L150 405L184 330Z"
                fill="#ff6aae"
              />

              <path
                class="rocket-fire"
                d="M128 332L150 385L172 332Z"
                fill="#ffd077"
              />
            </svg>
          </div>
        </div>
      </div>

      <div class="hero-divider" aria-hidden="true">
        <svg
          viewBox="0 0 1440 220"
          preserveAspectRatio="none"
        >
          <path
            d="M0 112C260 210 465 180 720 138C984 95 1184 103 1440 62V220H0Z"
            fill="#fbf8ff"
          />
        </svg>
      </div>
    </section>

    <!-- =====================================================
         TEMAS
    ====================================================== -->

    <section class="topics-section" id="temas">
      <div class="topics-head">
        <h2>
          <span class="topics-title-main">Nueve temas,</span>
          <span class="topics-title-pink">un mismo</span>
          <span class="topics-title-purple">principio.</span>
        </h2>

        <a href="#topic-grid" class="topics-link">
          Avance 1 + Avance 2
          <span>→</span>
        </a>
      </div>

      <div class="topics-grid" id="topic-grid">
        {
          topics.map((topic) => (
            <a
              href={topic.href}
              class="topic-card"
            >
              <div
                class:list={[
                  "topic-icon",
                  topic.icon,
                ]}
              ></div>

              <div class="topic-content">
                <span class="topic-number">
                  {topic.number}
                </span>

                <h3>{topic.title}</h3>

                <p>{topic.description}</p>
              </div>

              <span class="topic-arrow">
                →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- =====================================================
         AVANCES
    ====================================================== -->

    <section class="advances-section" id="avances">
      <div class="advances-intro">
        <span class="method-label">
          PORTAFOLIO ACUMULATIVO
        </span>

        <h2>
          Del primer avance
          <em>al segundo.</em>
        </h2>

        <p>
          El segundo avance mantiene los cinco casos desarrollados
          anteriormente y amplía el portafolio con cuatro nuevas
          aplicaciones de conservación y gravitación.
        </p>
      </div>

      <div class="advances-grid">
        <article class="advance-card">
          <span class="advance-number">01</span>

          <small>AVANCE 1</small>

          <h3>Cinemática y dinámica</h3>

          <p>
            Primer bloque del portafolio con cinco aplicaciones de
            movimiento, gravedad, rotación, fricción y elasticidad.
          </p>

          <div class="advance-items">
            <span>01 · Dron de reparto</span>
            <span>02 · Salto en videojuegos</span>
            <span>03 · Gravedad artificial</span>
            <span>04 · Fórmula 1</span>
            <span>05 · Control háptico</span>
          </div>
        </article>

        <article class="advance-card advance-card-current">
          <span class="advance-number">02</span>

          <small>AVANCE 2</small>

          <h3>Conservación y gravitación</h3>

          <p>
            Cuatro nuevas aplicaciones que extienden el portafolio
            hasta nueve temas acumulativos.
          </p>

          <div class="advance-items">
            <span>06 · Frenado regenerativo</span>
            <span>07 · Coeficiente de restitución</span>
            <span>08 · Ruedas de reacción</span>
            <span>09 · Asistencia gravitatoria</span>
          </div>
        </article>
      </div>
    </section>

    <!-- =====================================================
         MÉTODO
    ====================================================== -->

    <section class="method-section" id="metodo">
      <div class="method-intro">
        <span class="method-label">
          MÉTODO
        </span>

        <h2>
          La ecuación
          <em>no es el final.</em>
        </h2>
      </div>

      <div class="method-list">
        {
          methodSteps.map((step) => (
            <article>
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>

  <script>
    const hero =
      document.querySelector<HTMLElement>(
        ".hero-full"
      );

    const heroBg =
      document.querySelector<HTMLElement>(
        ".hero-bg"
      );

    const heroVisual =
      document.querySelector<HTMLElement>(
        ".hero-visual"
      );

    if (hero && heroBg && heroVisual) {
      hero.addEventListener(
        "pointermove",
        (event) => {
          const rect =
            hero.getBoundingClientRect();

          const x =
            (event.clientX - rect.left) /
              rect.width -
            0.5;

          const y =
            (event.clientY - rect.top) /
              rect.height -
            0.5;

          heroBg.style.setProperty(
            "--bg-x",
            `${x * 10}px`
          );

          heroBg.style.setProperty(
            "--bg-y",
            `${y * 10}px`
          );

          heroVisual.style.setProperty(
            "--scene-x",
            `${x * -12}px`
          );

          heroVisual.style.setProperty(
            "--scene-y",
            `${y * -8}px`
          );
        }
      );

      hero.addEventListener(
        "pointerleave",
        () => {
          heroBg.style.setProperty(
            "--bg-x",
            "0px"
          );

          heroBg.style.setProperty(
            "--bg-y",
            "0px"
          );

          heroVisual.style.setProperty(
            "--scene-x",
            "0px"
          );

          heroVisual.style.setProperty(
            "--scene-y",
            "0px"
          );
        }
      );
    }
  </script>
</BaseLayout>
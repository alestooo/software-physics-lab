---
import "../../styles/sidebar.css";

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  return currentPath === href;
};

const topics = [
  {
    group: "Cinemática",
    items: [
      {
        number: "01",
        title: "Dron de reparto",
        href: "/dron",
      },
      {
        number: "02",
        title: "Salto en videojuegos",
        href: "/salto-videojuegos",
      },
    ],
  },
  {
    group: "Dinámica",
    items: [
      {
        number: "03",
        title: "Gravedad artificial",
        href: "/gravedad-artificial",
      },
      {
        number: "04",
        title: "Fórmula 1",
        href: "/formula-1",
      },
      {
        number: "05",
        title: "Control háptico",
        href: "/control-haptico",
      },
    ],
  },
];
---

<aside class="sidebar">

  <!-- BRAND -->

  <a
    class="sidebar-brand"
    href="/"
  >
    <div class="sidebar-brand-icon">

      <span class="sidebar-brand-ring"></span>
      <span class="sidebar-brand-dot"></span>

    </div>

    <div class="sidebar-brand-copy">

      <strong class="sidebar-brand-title">
        <span>
          Physics
        </span>

        <span class="sidebar-brand-x">
          ×
        </span>

        <span>
          Software
        </span>
      </strong>

      <span class="sidebar-brand-subtitle">
        Portafolio de evidencias
      </span>

    </div>
  </a>

  <div class="sidebar-divider"></div>

  <!-- HOME -->

  <a
    href="/"
    class:list={[
      "sidebar-home",
      isActive("/") && "active",
    ]}
  >

    <span class="sidebar-home-icon">

      <svg
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M4 10.5 12 4l8 6.5V20H4v-9.5Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        />

        <path
          d="M9 20v-6h6v6"
          stroke="currentColor"
          stroke-width="1.7"
        />
      </svg>

    </span>

    <span class="sidebar-home-label">
      Inicio
    </span>

    <span class="sidebar-item-arrow">
      →
    </span>

  </a>

  <!-- NAVIGATION -->

  <nav class="sidebar-navigation">

    {
      topics.map((section) => (

        <section class="sidebar-section">

          <p class="sidebar-heading">
            {section.group}
          </p>

          <div class="sidebar-items">

            {
              section.items.map((item) => (

                <a
                  href={item.href}
                  class:list={[
                    "sidebar-nav-item",
                    isActive(item.href) && "active",
                  ]}
                >

                  <span class="sidebar-topic-number">
                    {item.number}
                  </span>

                  <span class="sidebar-topic-name">
                    {item.title}
                  </span>

                  <span class="sidebar-item-arrow">
                    →
                  </span>

                </a>

              ))
            }

          </div>

        </section>

      ))
    }

  </nav>

  <!-- BOTTOM -->

  <div class="sidebar-bottom">

    <div class="sidebar-divider"></div>

    <a
      href="https://github.com/alestooo/software-physics-lab"
      target="_blank"
      rel="noreferrer"
      class="sidebar-github"
    >

      <svg
        class="sidebar-github-icon"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.1-4.7-5a3.9 3.9 0 0 1 1-2.7 3.6 3.6 0 0 1 .1-2.7s.8-.3 2.8 1a9.5 9.5 0 0 1 5 0c2-1.3 2.8-1 2.8-1a3.6 3.6 0 0 1 .1 2.7 3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.7 5 .4.3.7 1 .7 1.9v2.7c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.5Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>

      <span>
        Repositorio
      </span>

      <span class="sidebar-github-arrow">
        ↗
      </span>

    </a>

    <p class="sidebar-course">
      Física I · CENFOTEC
    </p>

  </div>

</aside>
---
import "../../styles/evidence.css";
import "../../styles/sidebar.css";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const sections = [
  {
    "title": "Cinemática",
    "items": [
      {
        "number": "01",
        "label": "Dron de reparto",
        "href": "/dron"
      },
      {
        "number": "02",
        "label": "Salto en videojuegos",
        "href": "/salto-videojuegos"
      }
    ]
  },
  {
    "title": "Dinámica",
    "items": [
      {
        "number": "03",
        "label": "Gravedad artificial",
        "href": "/gravedad-artificial"
      },
      {
        "number": "04",
        "label": "Fórmula 1",
        "href": "/formula-1"
      },
      {
        "number": "05",
        "label": "Control háptico",
        "href": "/control-haptico"
      }
    ]
  },
  {
    "title": "Conservación",
    "items": [
      {
        "number": "06",
        "label": "Frenado regenerativo",
        "href": "/frenado-regenerativo"
      },
      {
        "number": "07",
        "label": "Coeficiente de restitución",
        "href": "/coeficiente-restitucion"
      },
      {
        "number": "08",
        "label": "Ruedas de reacción",
        "href": "/ruedas-reaccion"
      }
    ]
  },
  {
    "title": "Gravitación",
    "items": [
      {
        "number": "09",
        "label": "Asistencia gravitatoria",
        "href": "/asistencia-gravitatoria"
      }
    ]
  },
  {
    "title": "Oscilaciones",
    "items": [
      {
        "number": "10",
        "label": "Spring animations",
        "href": "/spring-animations"
      },
      {
        "number": "11",
        "label": "Síntesis de sonido",
        "href": "/sintesis-sonido"
      },
      {
        "number": "12",
        "label": "Resonancia estructural",
        "href": "/resonancia-estructural"
      }
    ]
  },
  {
    "title": "Fluidos",
    "items": [
      {
        "number": "13",
        "label": "Enfriamiento líquido",
        "href": "/enfriamiento-liquido"
      }
    ]
  },
  {
    "title": "Cierre",
    "items": [
      {
        "number": "✦",
        "label": "Qué aprendí",
        "href": "/que-aprendi"
      }
    ]
  }
];
const isActive = (href:string) => currentPath === href;
---
<aside class="sidebar">
  <a href="/" class="sidebar-brand" aria-label="Ir al inicio">
    <span class="sidebar-brand-icon" aria-hidden="true"><span class="sidebar-brand-ring"></span><span class="sidebar-brand-dot"></span></span>
    <span class="sidebar-brand-copy"><strong class="sidebar-brand-title"><span>Physics</span><span class="sidebar-brand-x">×</span><span>Software</span></strong><span class="sidebar-brand-subtitle">Portafolio de evidencias<br/>— Alejandro Soto Víquez</span></span>
  </a>
  <div class="sidebar-divider"></div>
  <a href="/" class:list={["sidebar-home",isActive("/")&&"active"]}>
    <span class="sidebar-home-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M4 10.5L12 4L20 10.5V20H14.8V14H9.2V20H4V10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
    <span class="sidebar-home-label">Inicio</span><span class="sidebar-item-arrow">→</span>
  </a>
  <nav class="sidebar-navigation" aria-label="Temas del portafolio" style="overflow-y:auto;min-height:0;flex:1">
  {sections.map(section=><section class="sidebar-section"><h2 class="sidebar-heading">{section.title}</h2><div class="sidebar-items">
  {section.items.map(item=><a href={item.href} aria-current={isActive(item.href)?"page":undefined} class:list={["sidebar-nav-item",isActive(item.href)&&"active"]}><span class="sidebar-topic-number">{item.number}</span><span class="sidebar-topic-name">{item.label}</span><span class="sidebar-item-arrow">→</span></a>)}
  </div></section>)}
  </nav>
  <div class="sidebar-bottom"><div class="sidebar-divider"></div><a href="https://github.com/alestooo/software-physics-lab" target="_blank" rel="noreferrer" class="sidebar-github"><span>Repositorio</span><span class="sidebar-github-arrow">↗</span></a><span class="sidebar-course">Física I · CENFOTEC</span></div>
</aside>
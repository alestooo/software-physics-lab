---
import "../styles/global.css";
import Sidebar from "../components/ui/Sidebar.astro";

interface Props {
  title?: string;
  description?: string;
  fullBleed?: boolean;
}

const {
  title = "Physics × Software",
  description =
    "Portafolio interactivo sobre aplicaciones de la física en Ingeniería del Software.",
  fullBleed = false,
} = Astro.props;
---

<!doctype html>

<html lang="es">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#20106f"
    />

    <title>
      {title}
    </title>

  </head>

  <body>

    <div class="app-shell">

      <!-- =========================================
           MOBILE HEADER
      ========================================== -->

      <header class="mobile-topbar">

        <a
          href="/"
          class="mobile-brand"
          aria-label="Ir al inicio"
        >

          <span class="mobile-brand-mark">

            <span class="mobile-brand-ring"></span>
            <span class="mobile-brand-dot"></span>

          </span>

          <span class="mobile-brand-text">

            <span>
              Physics
            </span>

            <b>
              ×
            </b>

            <span>
              Software
            </span>

          </span>

        </a>

        <button
          id="mobile-menu-toggle"
          class="mobile-menu-toggle"
          type="button"
          aria-label="Abrir menú"
          aria-controls="site-sidebar"
          aria-expanded="false"
        >

          <span></span>
          <span></span>
          <span></span>

        </button>

      </header>


      <!-- =========================================
           MOBILE OVERLAY
      ========================================== -->

      <button
        id="mobile-sidebar-backdrop"
        class="mobile-sidebar-backdrop"
        type="button"
        tabindex="-1"
        aria-label="Cerrar menú"
      ></button>


      <!-- =========================================
           SIDEBAR
      ========================================== -->

      <div
        class="desktop-sidebar"
        id="site-sidebar"
      >

        <Sidebar />

      </div>


      <!-- =========================================
           CONTENT
      ========================================== -->

      <main
        class:list={[
          "main-content",
          fullBleed &&
            "main-content-full"
        ]}
      >

        <div
          class:list={[
            "content-container",
            fullBleed &&
              "content-container-full"
          ]}
        >

          <slot />

        </div>

      </main>

    </div>


    <!-- =========================================
         MOBILE MENU SCRIPT
    ========================================== -->

    <script>
      import "../scripts/ui/mobile-sidebar.ts";
    </script>

  </body>

</html>